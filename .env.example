# .env.example
# Copy this file to .env and fill in your actual values

# ============================================
# Ring Configuration
# ============================================
# Your Ring API refresh token
# NOTE: This token will auto-refresh - the bot updates your .env file automatically
# Get your initial token by following Ring API authentication instructions
RING_REFRESH_TOKEN=your_ring_refresh_token_here

# ============================================
# Telegram Configuration (optional — omit this section for S3-only deployments)
# ============================================
# Your Telegram bot token from @BotFather
# This token does NOT expire unless you manually revoke it
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Space-separated list of chat IDs to send videos to
# Get your chat ID by messaging @userinfobot on Telegram
TELEGRAM_BOT_CHATS=123456789 987654321

# ============================================
# S3/Cloudflare R2 Configuration (optional — omit this section for Telegram-only deployments)
# ============================================
# R2 endpoint format: https://[account-id].r2.cloudflarestorage.com
# For AWS S3: https://s3.amazonaws.com or region-specific endpoint
# Find your account ID in Cloudflare Dashboard → R2
S3_ENDPOINT=https://abc123def456.r2.cloudflarestorage.com

# Region: "auto" for Cloudflare R2, or AWS region like "us-east-1"
S3_REGION=auto

# Your S3/R2 bucket name
# Create this in Cloudflare Dashboard → R2 → Create Bucket
S3_BUCKET=ring-recordings

# R2 Access Key ID (from R2 API Tokens page)
# These tokens do NOT expire by default (permanent unless you set expiration)
S3_ACCESS_KEY_ID=your_r2_access_key_id

# R2 Secret Access Key (from R2 API Tokens page)
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional: Custom domain for public access URLs
# Configure this in R2 bucket settings → Public Access → Custom Domains
# If not set, URLs will use the R2 endpoint
# S3_PUBLIC_URL=https://recordings.example.com

# ============================================
# Recording Configuration
# ============================================
# Duration in seconds for each recording
# Default: 30
RECORDING_DURATION=30

# Directory to save recordings temporarily
# Default: /tmp
# Note: If using Docker, ensure this directory is writable
RECORDING_DIR=/tmp

# Delete local files after successful upload to all destinations
# Options: true or false
# Default: false
# Set to true to save disk space (files deleted only if ALL uploads succeed)
CLEANUP_LOCAL_FILES=true
